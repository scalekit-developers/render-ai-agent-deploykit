# Web server
PORT=3000

# Public URL of this service — used to build the OAuth callback URL (/user/verify).
# In development: http://localhost:3000
# In production:  https://your-service.onrender.com
PUBLIC_BASE_URL=http://localhost:3000

# Session secret — signs HTTP-only session cookies (HMAC-SHA256).
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-session-secret

# LLM — any OpenAI-compatible API. Leave OPENAI_BASE_URL empty to use OpenAI directly;
# set it to a proxy URL to route calls through LiteLLM, Azure OpenAI, Ollama, etc.
#
# OpenAI direct (recommended defaults):
#   OPENAI_API_KEY=sk-proj-...   # project secret key, Restricted permissions
#   OPENAI_BASE_URL=             (leave empty / unset)
#   OPENAI_MODEL=gpt-5-mini      # or gpt-5.6-terra / gpt-5.6-sol for higher quality
#
# Scope permissions (OpenAI dashboard → Restricted) — see README:
#   - Model capabilities: Write   (required for chat.completions)
#   - List models: Read or None   (optional)
#   - All other rows: None
#     (Assistants, Threads, Evals, Fine-tuning, Files, Videos,
#      Vector stores, Prompts, Batch, Tunnels, Datasets)
#   - Optionally allow only the model ids you set in OPENAI_MODEL
#   - Set a project spend limit
#
# LiteLLM proxy:
#   OPENAI_API_KEY=<your-litellm-virtual-key>
#   OPENAI_BASE_URL=https://your-litellm-proxy.example.com/v1
#   OPENAI_MODEL=claude-haiku-4-5   (or any id from GET /v1/models for your key)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini

# Scalekit AgentKit
SCALEKIT_ENVIRONMENT_URL=https://your-env.scalekit.com
SCALEKIT_CLIENT_ID=your-scalekit-client-id
SCALEKIT_CLIENT_SECRET=your-scalekit-client-secret

# Scalekit GitHub connection name — copy from Scalekit Dashboard → AgentKit → Connectors
# Each Scalekit environment gets a unique name (e.g. github-abc12345).
# Optional: defaults to github-qkHFhMip (Render/Apify Demo on sampleapps.scalekit.com).
GITHUB_CONNECTION_NAME=github-qkHFhMip
